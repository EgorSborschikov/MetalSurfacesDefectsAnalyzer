<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.19.2" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.onnx" />
		<EmbeddedResource Include="Resources\*.onnx.data" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\resnet.onnx.data" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\model_eta_0_00.onnx">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\model_eta_0_00.onnx.data">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\model_eta_0_04.onnx">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\model_eta_0_04.onnx.data">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\model_eta_0_07.onnx">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\model_eta_0_07.onnx.data">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\resnet.onnx">
	    <CopyToOutputDirectory>PreserverNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\resnet.onnx.data">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>
</Project>
