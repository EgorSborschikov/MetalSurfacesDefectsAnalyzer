<Page x:Class="MetalSurfacesDefectsAnalyzer.App.Pages.AnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Анализ дефектов"
      FontFamily="Microsoft Sans Serif"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource InfoCardStyle}"
                Margin="15,15,15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Анализ дефектов металлических поверхностей"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock x:Name="TxtSubtitle" 
                              Style="{StaticResource SubtitleStyle}"
                              Text="Загрузка модели и подготовка к анализу..."/>
                </StackPanel>

                <Border Grid.Column="1" x:Name="ModelStatusBadge" 
                        Background="#F39C12" CornerRadius="15" 
                        Padding="15,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModelStatus" 
                              Text="Модель не загружена" 
                              Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource InfoCardStyle}"
                Margin="15,10,15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnStartAnalysis" 
                            Content="Запустить анализ"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnStartAnalysis_Click"
                            IsEnabled="False"
                            FontSize="15" Padding="30,18"/>

                    <Button x:Name="BtnCancelAnalysis" 
                            Content="Отменить"
                            Style="{StaticResource CancelButtonStyle}"
                            Click="BtnCancelAnalysis_Click"
                            Visibility="Collapsed"
                            FontSize="15" Padding="20,18"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Параметры анализа:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"
                               FontSize="12"/>

                    <WrapPanel>
                        <TextBlock Text="Модель:" Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtModelInfo" Text="η=0.04" 
                                 FontWeight="Bold" Margin="5,0" FontSize="12"/>
                        <TextBlock Text="|" Margin="10,0" Foreground="#BDC3C7"/>
                        <TextBlock Text="Кластеров (по умолчанию):" Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock Text="12" FontWeight="Bold" Margin="5,0" FontSize="12"/>
                        <TextBlock Text="|" Margin="10,0" Foreground="#BDC3C7"/>
                        <TextBlock Text="Изображений к анализу:" Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtImageCount" Text="0" FontWeight="Bold" Margin="5,0" FontSize="12"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnBack"
                            Content="Назад к загрузке"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnBack_Click"
                            IsEnabled="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource InfoCardStyle}"
                Margin="15,10,15,15">
            <Grid>
                <StackPanel x:Name="NoDataPanel" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Visible">
                    <TextBlock Text="📷" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Нет данных для анализа" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="#95A5A6"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Загрузите изображения на предыдущем шаге"
                              FontSize="13" Foreground="#BDC3C7"
                              HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed">

                    <TextBlock x:Name="TxtProgressTitle" 
                              Text="Подготовка к анализу..." 
                              FontSize="20" FontWeight="SemiBold"
                              HorizontalAlignment="Center" Margin="0,0,0,25"
                              Foreground="#2C3E50"/>

                    <Grid Width="500" Margin="0,0,0,15">
                        <ProgressBar x:Name="ProgressBar" 
                                    Height="30"
                                    Minimum="0" Maximum="100" Value="0"
                                    Foreground="#3498DB"
                                    Background="#ECF0F1"
                                    BorderBrush="#BDC3C7"
                                    BorderThickness="1"/>
                        <TextBlock x:Name="TxtProgressPercent" 
                                  Text="0%"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  FontWeight="Bold" FontSize="14"
                                  Foreground="White"/>
                    </Grid>

                    <TextBlock x:Name="TxtProgressDetail" 
                              Text="Инициализация..."
                              FontSize="13" Foreground="#7F8C8D"
                              HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    
                    <Border Background="#F8F9FA" CornerRadius="5" Padding="15" 
                           Margin="0,20,0,0" Width="400">
                        <StackPanel>
                            <TextBlock Text="Статистика выполнения:" 
                                      FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="Этап:" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          x:Name="TxtStage" Text="1/2" 
                                          FontSize="11" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          Text="Обработано:" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                          x:Name="TxtProcessed" Text="0" 
                                          FontSize="11" FontWeight="Bold"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          Text="Ошибок:" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                          x:Name="TxtErrors" Text="0" 
                                          FontSize="11" Foreground="#E74C3C"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CompletedPanel" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed">

                    <TextBlock Text="✅" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Анализ завершён!" 
                              FontSize="22" FontWeight="Bold"
                              Foreground="#27AE60"
                              HorizontalAlignment="Center"/>

                    <Border Background="#ECF0F1" Padding="20" CornerRadius="8" 
                           Margin="0,20,0,0" MinWidth="400">
                        <StackPanel>
                            <TextBlock Text="Результаты анализа:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="Всего изображений:" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          x:Name="TxtTotalProcessed" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          Text="Успешно обработано:" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                          x:Name="TxtSuccessful" FontWeight="Bold" Foreground="#27AE60"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          Text="Обнаружено кластеров:" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                          x:Name="TxtClustersFound" FontWeight="Bold" Foreground="#3498DB"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                          Text="Время анализа:" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                          x:Name="TxtAnalysisTime" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                        <Button Content="Просмотр результатов" 
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnViewResults_Click"
                                FontSize="15" Padding="30,18"/>

                        <Button Content="Визуализация" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#9B59B6"
                                Click="BtnVisualization_Click"
                                FontSize="15" Padding="25,18"/>


                        <Button Content="Экспорт" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#27AE60"
                                Click="BtnExport_Click"
                                FontSize="15" Padding="25,18"/>
                    </StackPanel>

                    <TextBlock Text="Для детального анализа каждого изображения с распределением вероятностей по кластерам перейдите в «Результаты»"
                              FontSize="11" Foreground="#7F8C8D" 
                              HorizontalAlignment="Center" Margin="0,15,0,0"
                              TextWrapping="Wrap" Width="450"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
