<Page x:Class="MetalSurfacesDefectsAnalyzer.App.Pages.ResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Pages" 
      xmlns:converters="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      FontFamily="Microsoft Sans Serif"
      Loaded="Page_Loaded"
      Title="Результаты анализа">

    <Page.Resources>
        <Style x:Key="ClusterBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <converters:SelectedToBrushConverter x:Key="SelectedToBrushConverter"/>
    </Page.Resources>

    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Проанализированные изображения" 
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <ListBox Grid.Row="1" x:Name="LbImages" 
                         SelectionChanged="LbImages_SelectionChanged"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" CornerRadius="4" 
                                    Background="{Binding IsSelected, Converter={StaticResource SelectedToBrushConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" 
                                           Source="{Binding Thumbnail}" 
                                           Width="50" Height="40" Stretch="Uniform"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#7F8C8D">
                                            <Run Text="Кластер "/>
                                            <Run Text="{Binding PrimaryCluster}" FontWeight="Bold"/>
                                            <Run Text=" | Уверенность: "/>
                                            <Run Text="{Binding Confidence, StringFormat={}{0:P1}}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" Background="#BDC3C7" HorizontalAlignment="Center"/>

        <Border Grid.Column="2" Background="White" Margin="10" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Детальный анализ изображения" 
                               FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="TxtSelectedFile" Text="Выберите изображение слева" 
                               FontSize="12" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#ECF0F1" Padding="15" CornerRadius="6" Margin="0,0,0,15"
                        x:Name="SummaryPanel" Visibility="Collapsed">
                    <WrapPanel>
                        <TextBlock Text="Основной кластер: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtMainCluster" FontWeight="Bold" Foreground="#3498DB"/>
                        <TextBlock Text=" | " Margin="10,0"/>
                        <TextBlock Text="Уверенность: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtConfidence" FontWeight="Bold" Foreground="#27AE60"/>
                        <TextBlock Text=" | " Margin="10,0"/>
                        <TextBlock Text="Энтропия H(γ): " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtEntropy" FontWeight="Bold" Foreground="#E67E22"/>
                        <TextBlock Text=" | " Margin="10,0"/>
                        <TextBlock Text="Неопределённость: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUncertainty" FontWeight="Bold" Foreground="#E74C3C"/>
                    </WrapPanel>
                </Border>
                
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcClusterBars" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8" CornerRadius="4" Background="#F8F9FA">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" 
                                                   FontWeight="SemiBold" FontSize="12">
                                            <Run Text="Кластер "/>
                                            <Run Text="{Binding ClusterId}"/>
                                        </TextBlock>

                                        <ProgressBar Grid.Column="1" 
                                                     Value="{Binding Probability}"
                                                     Height="20" 
                                                     Foreground="{Binding BarColor}"
                                                     Style="{StaticResource ClusterBarStyle}"/>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Probability, StringFormat={}{0:P1}}" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="Bold" FontSize="12"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Background="#F8F9FA" Margin="0,10,0,0"
                        x:Name="LatentPanel" Visibility="Collapsed">
                    <TextBlock Text="Вектор скрытого пространства z:" FontSize="11" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtLatentVector" FontSize="10" FontFamily="Consolas" Margin="0,5,0,0" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
