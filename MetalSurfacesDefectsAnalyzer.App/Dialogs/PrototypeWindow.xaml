<Window x:Class="MetalSurfacesDefectsAnalyzer.App.Dialogs.PrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif"
        Title="Прототипы кластеров" Height="600" Width="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Прототипы кластеров (декодированные центроиды GMM)" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="PrototypesPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
