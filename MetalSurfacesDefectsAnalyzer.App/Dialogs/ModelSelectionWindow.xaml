<Window x:Class="MetalSurfacesDefectsAnalyzer.App.Dialogs.ModelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Title="Выбор параметра регуляризации энтропии присваиваний" Height="550" Width="700">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Выбор параметра энтропийной регуляризации η" 
                      FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Параметр η контролирует баланс между качеством кластеризации и мягкостью присваиваний"
                      FontSize="12" Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Информация о параметре -->
        <Border Grid.Row="1" Background="#EBF5FB" Padding="15" CornerRadius="6" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Как выбрать η:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                <WrapPanel Margin="0,3">
                    <Border Background="#3498DB" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="η = 0.00" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Базовая модель — жёсткая кластеризация, максимальная уверенность" 
                              FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>

                <WrapPanel Margin="0,3">
                    <Border Background="#27AE60" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="η = 0.04" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Оптимальный баланс — высокое качество + умеренная мягкость (рекомендуется)" 
                              FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>

                <WrapPanel Margin="0,3">
                    <Border Background="#E67E22" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="η = 0.07" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Мягкая кластеризация — для задач со смешанной принадлежностью" 
                              FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Список доступных моделей -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="LvModels" Margin="10"
                     SelectionMode="Single"
                     SelectionChanged="LvModels_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="η" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Eta, StringFormat={}{0:F2}}" 
                                              FontWeight="Bold" FontSize="13"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Тип кластеризации" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                            Background="{Binding TypeColor}">
                                        <TextBlock Text="{Binding Type}" Foreground="White" 
                                                  FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Описание" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" 
                                              FontSize="12" VerticalAlignment="Center"
                                              TextWrapping="Wrap"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="NMI" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NMI, StringFormat={}{0:F3}}" 
                                              FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="H(γ)" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Entropy, StringFormat={}{0:F3}}" 
                                              FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click" 
                   Width="100" Height="35" Margin="0,0,10,0"
                   Background="#95A5A6" Foreground="White"
                   BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="BtnSelect" Content="Выбрать" Click="BtnSelect_Click" 
                   Width="120" Height="35"
                   Background="#3498DB" Foreground="White"
                   BorderThickness="0" Cursor="Hand"
                   IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
