<Window x:Class="MetalSurfacesDefectsAnalyzer.App.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft Sans Serif"
        Title="Экспорт результатов" Height="350" Width="450">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Выберите формат экспорта:" FontSize="14" Margin="0,0,0,20"/>

            <RadioButton x:Name="RbJson" Content="JSON (*.json)" 
                        IsChecked="True" Margin="0,5"/>
            <RadioButton x:Name="RbCsv" Content="CSV (*.csv)" 
                        Margin="0,5"/>
            <RadioButton x:Name="RbPdf" Content="HTML (*.html)" 
                        Margin="0,5"/>

            <TextBlock Text="Дополнительно:" FontSize="13" Margin="0,15,0,5"/>
            <CheckBox x:Name="CbIncludeVisualizations" 
                     Content="Включить t-SNE и UMAP проекции (только HTML)"
                     IsChecked="True"
                     IsEnabled="{Binding ElementName=RbPdf, Path=IsChecked}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Отмена" Click="BtnCancel_Click" 
                       Width="100" Height="35" Margin="0,0,10,0"
                       Background="#95A5A6" Foreground="White"
                       BorderThickness="0" Cursor="Hand"/>

                <Button Content="Экспорт" Click="BtnExport_Click" 
                       Width="120" Height="35"
                       Background="#3498DB" Foreground="White"
                       BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
