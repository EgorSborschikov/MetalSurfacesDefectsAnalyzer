<Window x:Class="MetalSurfacesDefectsAnalyzer.App.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetalSurfacesDefectsAnalyzer.App.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft Sans Serif"
        Title="О программе" Height="400" Width="500">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Анализатор дефектов металллических поверхностей"
                       FontSize="18" 
                       FontWeight="Bold" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock Text="Версия: 0.0.1"
                       FontSize="14"
                       Margin="0,20,0,10"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Система анализа, основанная на глубокой кластеризации с контролируемоей энтропией мягких присваиваний"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <Button Content="Руководство пользователя (PDF)" 
                    Margin="0,30,0,0" 
                    Padding="15,10"
                    Background="#3D5A80"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Click="OnUserGuide_Click"/>
        </StackPanel>
    </Grid>
</Window>
